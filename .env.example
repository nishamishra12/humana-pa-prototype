# Copy to .env and fill in. .env is never committed.
ANTHROPIC_API_KEY=
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_PLATFORM_API_KEY=
# Honeycomb: an ingest key from Environment settings > API keys (allow "send events" and "create datasets").
# Leave blank to run with no telemetry. US teams need no endpoint line. EU teams: https://api.eu1.honeycomb.io
HONEYCOMB_API_KEY=
# HONEYCOMB_API_ENDPOINT=
